{
  "$schema": "https://raw.githubusercontent.com/nickolay/jcb-backer/master/tauri.conf.json",
  "productName": "xShare",
  "version": "0.5.3",
  "identifier": "com.xshare.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xShare - LAN File Sharing",
        "width": 900,
        "height": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/go-engine"
    ],
    "resources": [
      "resources/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCMzQ3MDgzMDA5RTlEQ0MKUldUTW5aNEFnM0EwYTdWbTUzUVVXVjlPRCsyVEpZcTZFVW5SS2h5c2dYbFQ1QlhwajBrTzFIbU4K",
      "endpoints": [
        "https://github.com/whoarei/xShare/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
